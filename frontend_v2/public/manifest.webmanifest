      "purpose": "any"
    },
    {
      "src": "/icons/mmg-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/mmg-icon-maskable-512.png",
      "sizes": "512x512",
