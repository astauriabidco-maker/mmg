# MMG production environment example.
# Copy to .env and replace every CHANGE_ME value before deployment.

APP_ENV=production

# Backend
BACKEND_PORT=7000
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=720
POSTGRES_DB=mmg
POSTGRES_USER=mmg
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
DATABASE_URL=postgresql://mmg:CHANGE_ME_strong_database_password@db:5432/mmg
FRONTEND_BASE_URL=https://mmg.example.com
CORS_ORIGINS=https://mmg.example.com

# Bootstrap admin. init_db.py refuses ADMIN_PASSWORD=1234 in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Optional integrations
OPENAI_API_KEY=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
MANAGER_PHONE=

# Printing / file watcher
LABEL_OUTPUT_DIR=/data/output/labels
WATCH_DIR=/data/exports_proges_valides
OUTPUT_QR_DIR=/data/output/qr
API_URL=http://backend:7000
PRINTER_NAME=
# Le watcher (qr_generator.py) utilise SMTP_SERVER + le SMTP_PORT partagé ci-dessous.
SMTP_SERVER=localhost

# Transactional emails (quote confirmation, supplier reminders with PDF attachments).
# Leave SMTP_HOST/SMTP_FROM empty to keep email sending disabled (graceful skip).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PURCHASES_CC_EMAIL=

# Frontend image build arg used by docker-compose.
FRONTEND_PORT=5000
VITE_API_URL=https://api.mmg.example.com
